# Default configuration for new accounts (seeded into user_settings).
# All values are optional; leave unset to use the hardcoded fallbacks.
# API tokens are intentionally NOT seeded here: every account fills its own
# token via the Settings UI so credentials stay isolated per user.

# Image generation / edits
AI_BASE_URL=https://api.openai.com/v1
AI_GENERATIONS_MODEL=gpt-image-2.5
AI_EDITS_MODEL=gpt-image-2.5

# Prompt enhancer (chat completions)
AI_ENHANCER_BASE_URL=https://api.openai.com/v1
AI_ENHANCER_MODEL=gpt-4o-mini

# Only trust X-Forwarded-For / X-Real-IP / X-Forwarded-Proto headers when running
# behind a trusted proxy that overwrites them. Leave false otherwise, so spoofed
# client headers cannot bypass rate limiting or force the secure cookie flag.
TRUST_PROXY=false

# Sertakan detail error mentah pada respons API. Default: aktif saat NODE_ENV != production.
# Set "true" untuk menampilkan detail juga di produksi (mis. saat debugging).
EXPOSE_ERROR_DETAILS=false

# Zona waktu tampilan tanggal di UI. Default Asia/Jakarta (UTC+7).
# Set "UTC" bila ingin menampilkan UTC+0.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta