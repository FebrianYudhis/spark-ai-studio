# Default configuration for new accounts (seeded into app_settings).
# All values are optional; leave unset to use the hardcoded fallbacks.

# Image generation / edits
AI_BASE_URL=https://api.openai.com/v1
AI_API_TOKEN=sk-proj-dummyapikey1234567890abcdef
AI_GENERATIONS_MODEL=gpt-image-2.5
AI_EDITS_MODEL=gpt-image-2.5

# Prompt enhancer (chat completions)
AI_ENHANCER_BASE_URL=https://api.openai.com/v1
AI_ENHANCER_API_TOKEN=
AI_ENHANCER_MODEL=gpt-4o-mini

# Only trust X-Forwarded-For / X-Real-IP headers when running behind a trusted proxy.
TRUST_PROXY=false